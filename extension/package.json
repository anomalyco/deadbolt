{
  "name": "@deadbolt/extension",
  "private": true,
  "version": "0.1.0",
  "description": "Deadbolt's browser extension: fill and save logins through the local Deadbolt agent.",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:standalone": "bun scripts/build.ts --standalone",
    "watch": "bun scripts/build.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "tsc --noEmit && bun test",
    "e2e": "bun e2e/run.ts",
    "e2e:standalone": "bun e2e/standalone.ts",
    "e2e:standalone:smoke": "bun e2e/standalone.ts --smoke",
    "e2e:parallel": "bun scripts/e2e-parallel.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@simplewebauthn/server": "14.0.3",
    "@types/bun": "1.4.3",
    "@types/chrome": "0.3.5",
    "happy-dom": "21.0.4",
    "playwright-core": "1.64.1",
    "simple-icons": "16.36.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "tldts": "7.4.18"
  }
}
