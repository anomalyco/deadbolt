{
  "manifest_version": 3,
  "name": "Deadbolt",
  "short_name": "Deadbolt",
  "version": "0.1.0",
  "description": "Fill and save passwords from Deadbolt, the local-first password manager.",
  "minimum_chrome_version": "128",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "webNavigation", "favicon"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["passkey-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Deadbolt",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed",
  "web_accessible_resources": [
    {
      "resources": [
        "menu.html",
        "menu.css",
        "menu.js",
        "theme.css",
        "fonts/Inter-Variable.woff2",
        "fonts/IBMPlexMono-Regular.woff2",
        "fonts/IBMPlexMono-Medium.woff2"
      ],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": true
    }
  ]
}
