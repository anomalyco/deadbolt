{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "deadbolt-site",
  "account_id": "15d29c8639fd3733b1b5486a2acfd968",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "deadbolt.pw",
      "custom_domain": true
    }
  ],
  "env": {
    "dev": {
      "name": "deadbolt-dev-site",
      "account_id": "d8e944f537ceef3f06a5bd3aec1d7a53",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "dev.deadbolt.pw",
          "custom_domain": true
        }
      ]
    }
  }
}
